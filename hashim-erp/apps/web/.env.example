# ─────────────────────────────────────────────────────────────
#  هذا هو الملف الوحيد الذي تحتاج تعديله لربط النظام بـ Supabase
#  انسخه إلى .env ثم ضع القيمتين من: Supabase > Project Settings > API
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# اختياري: رمز العملة المعروض في الواجهة
VITE_CURRENCY_LABEL=ريال
